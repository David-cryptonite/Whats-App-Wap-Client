# ============ SERVER ============
NODE_ENV=development
PORT=3500
RTSP_PORT=8554
APP_DATA_DIR=./data
AUTH_DB_PATH=./auth.db
SESSION_DB_PATH=./sessions.db

# ============ AUTHENTICATION ============
# Set to false/0/no/off to disable login (default: true)
AUTH_ENABLED=true

# ============ HTTPS / TLS ============
# Set to true/1/yes/on to enable HTTPS with auto Let's Encrypt certs
HTTPS_ENABLED=false
HTTPS_DOMAIN=example.com
HTTPS_EMAIL=admin@example.com
HTTPS_PORT=443
HTTPS_CERTS_DIR=./certs

# ============ WHATSAPP PAIRING ============
# If set, uses pairing code instead of QR. Digits only, with country code.
# If empty/unset, uses QR code (no prompt).
# Example: 391234567890
WA_PHONE_NUMBER=

# ============ WAP PUSH NOTIFICATIONS ============
# Enable/disable WAP Push SI notifications for incoming messages
WAP_PUSH_ENABLED=false
# Delivery method: "nowsms" (HTTP GET to a NowSMS-compatible gateway, default)
# or "kannel" (direct multipart/related PAP push to a Kannel wappush service)
WAP_PUSH_METHOD=nowsms
# Phone number to receive WAP Push notifications (empty = disabled)
WAP_PUSH_PHONE=
# Max WAP Push sends (notifications + auto-deletes) per calendar month, across either
# delivery method. 0/empty = unlimited. Once reached, further sends are skipped and
# logged until the counter resets at the start of the next month.
WAP_PUSH_MAX_SMS_PER_MONTH=
# Public URL of this server reachable by the phone (used in WAP Push SI links)
# Must NOT be 127.0.0.1 — the phone needs to reach this from the mobile network
# Example: http://your-public-ip:3500
WAP_SERVER_BASE=

# ---- WAP_PUSH_METHOD=nowsms ----
# NowSMS gateway URL (e.g. http://your-nowsms-server:port/Send%20WAP%20Push%20Message.htm)
WAP_PUSH_BASE_URL=
# NowSMS Basic Auth header (base64 encoded user:pass, e.g. Basic dXNlcjpwYXNz)
WAP_PUSH_AUTH=

# ---- WAP_PUSH_METHOD=kannel ----
# Kannel wappush service URL (e.g. http://localhost:8080/wappush)
WAP_PUSH_KANNEL_URL=http://localhost:8080/wappush
# Optional Basic Auth header for the Kannel wappush service
WAP_PUSH_KANNEL_AUTH=
# PPG domain used to build the WAPPUSH address (WAPPUSH=+<phone>/TYPE=PLMN@<domain>)
WAP_PUSH_KANNEL_PPG=ppg.carrier.com
# Domain used to build the SI si-id value (<id>@<domain>)
WAP_PUSH_KANNEL_SI_DOMAIN=tuodominio.com

# ============ MARKUP MODE ============
# Leave unset (default) to auto-detect the right output format per request from
# the device's User-Agent — WAP 1.0 phones, WAP 2.0/XHTML-MP phones, and modern/
# Opera Mini browsers each get served correctly from the same running server.
# Set explicitly only to FORCE one format for every visitor regardless of device:
#   wml (WAP 1.x), xhtml (WAP 2.0), html5 (modern browsers)
MARKUP_MODE=

# ============ WML SETTINGS ============
# WML timer units for auto-refresh (1 unit = 0.1s, 100 = 10s)
WML_REFRESH_TIMER_UNITS=100
